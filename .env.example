# Copy to .env. Lab-only credentials; nothing here is a secret worth protecting.
POSTGRES_PASSWORD=keycloak
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
STALWART_ADMIN_PASSWORD=admin
# Password for every demo user, in both Keycloak and Stalwart. Stalwart's
# internal password policy requires at least 8 characters. Must match the
# value in keycloak/import/lab-realm.json.
DEMO_USER_PASSWORD=labdemo123
# Must match the secret in keycloak/import/lab-realm.json.
BULWARK_CLIENT_SECRET=bulwark-lab-secret
